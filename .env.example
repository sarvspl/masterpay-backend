# Server
PORT=4000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payverify

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Default admin (seeded once on first migration)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin@123

# Firebase Cloud Messaging — leave blank to disable push.
# When set, the backend pings every bound APK whenever a pending
# verification is created (TxnID submitted but no SMS matched yet).
FCM_SERVER_KEY=
